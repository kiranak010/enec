# Environment variables for the ENEC corporate site.
# Copy this file to `.env`/`.env.production` and fill in real values.
# Never commit real secrets.

# Database connection string (SQLite for local dev; PostgreSQL in production).
# Local:  DATABASE_URL="file:./dev.db"
# Prod:   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs (required in production).
# Generate one with:  openssl rand -base64 32
SESSION_SECRET="replace-me-with-openssl-rand-base64-32"

# Google OAuth SSO for the Admin portal.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  http://localhost:3000/api/auth/google/callback
# For production set the Authorized redirect to  {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Set to "1" to hide the email/password form on the admin login page (SSO-only).
NEXT_PUBLIC_DISABLE_PASSWORD_LOGIN=""

# Canonical site URL for sitemap/robots/metadata.
# Local:  http://localhost:3000
# Prod:   https://yourdomain.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional S3-compatible storage (falls back to local disk when unset).
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Rate-limiter store (in-memory default; set to "redis" + REDIS_URL to scale).
RATE_LIMIT_STORE="memory"
REDIS_URL=""